# ============================================================================
# TCGDesk — variables de entorno de Docker Compose
# ============================================================================
# Copia este fichero a .env y rellena los valores reales.
# NUNCA commitees el .env.
#
# Normalmente no hace falta editarlo a mano: ./dev-setup.sh lo genera
# preguntando solo por lo que falte (dev-setup.sh:127-172).
#
# QUÉ SE LEE DE AQUÍ, exactamente: docker-compose.yml interpola CUATRO claves
# —GOOGLE_CLIENT_ID, DB_PASSWORD, MYSQL_ROOT_PASSWORD y MYSQL_PASSWORD— y nada
# más. El resto de claves de este fichero son la referencia de lo que el backend
# lee de su PROPIO fichero de entorno, backend/.env.docker-development, que
# dev-setup.sh sincroniza desde aquí (dev-setup.sh:189-208). Si añades una clave
# aquí esperando que llegue sola a un contenedor, no llegará: hay que declararla
# además en docker-compose.yml.
# ============================================================================

# ----------------------------------------------------------------------------
# BASE DE DATOS
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tcgdesk_db
DB_USERNAME=tcgdesk_user
DB_PASSWORD=CAMBIAME_password_fuerte

MYSQL_ROOT_PASSWORD=CAMBIAME_root_password
MYSQL_PASSWORD=CAMBIAME_password_fuerte

# ----------------------------------------------------------------------------
# GOOGLE OAUTH — la ÚNICA credencial externa del proyecto
# ----------------------------------------------------------------------------
# Consíguela en https://console.cloud.google.com/ (tipo "aplicación web").
#
# No hay más claves de API porque no hay más APIs: el catálogo y los precios se
# ingieren de MTGJSON (licencia MIT, sin clave) con `php bin/tcgdesk`, y las
# imágenes se componen desde el CDN de Scryfall sin autenticación.
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# JWT
# ----------------------------------------------------------------------------
# Genera uno con: openssl rand -base64 32
JWT_SECRET=CAMBIAME_secreto_aleatorio_min_32_chars
JWT_EXPIRATION=3600

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_CHANNEL=file
LOG_PATH=/var/www/html/storage/logs

# ----------------------------------------------------------------------------
# SESIÓN Y SEGURIDAD
# ----------------------------------------------------------------------------
SESSION_LIFETIME=7200
SESSION_NAME=tcgdesk_session

CSRF_TOKEN_NAME=csrf_token
CSRF_TOKEN_EXPIRATION=3600

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
# En desarrollo estas variables no se usan: el CORS de dev lo resuelve
# backend/public/.htaccess reflejando el origen, y no hay proxy en el dev server
# de Vite (frontend/vite.config.js) ni debe haberlo. Son para producción.
# CORS_ALLOWED_ORIGINS=https://tcgdesk.dcahomelab.com
