<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        CAMERA lo exige el escáner de cartas (spike M0 del Plan - Escáner de
        Cartas por Cámara). Declararlo aquí NO basta: desde Android 6 el permiso
        se pide además en tiempo de ejecución, y `targetSdkVersion` es 36. Quien
        lo pide es `@capacitor-community/camera-preview`, que lleva
        @CapacitorPlugin(permissions = @Permission(CAMERA)) y dispara
        requestPermissionForAlias() dentro de su `start()`
        (CameraPreview.java:32,52-57). Lo que el plugin NO hace es explicar el
        rechazo: eso lo pinta la vista, porque una previsualización negra sin
        mensaje es el bug que más tiempo cuesta.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        `android.hardware.camera` declarado como NO requerido a propósito: con
        `required="true"` Google Play esconde la app a cualquier dispositivo sin
        cámara, y el escáner es una vía de entrada más a la colección, no la
        app entera. El resto de TCGDesk funciona sin cámara.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
