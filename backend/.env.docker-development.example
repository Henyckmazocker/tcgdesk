# ============================================================================
# TCGDesk backend — entorno de DESARROLLO en Docker
# ============================================================================
# dev-setup.sh copia este fichero a .env.docker-development y sincroniza desde
# el .env raíz las claves que comparten. El contenedor lo copia a .env al
# arrancar (ver el `command:` del servicio backend en docker-compose.yml).
#
# Las variables que docker-compose ya inyecta en el entorno del proceso
# (DB_*, APP_ENV, LOG_PATH, GOOGLE_CLIENT_ID) mandan sobre lo que ponga aquí.
# ============================================================================

APP_ENV=development
APP_TIMEZONE=Europe/Madrid

# ----------------------------------------------------------------------------
# Base de datos
# ----------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tcgdesk_db
DB_USERNAME=tcgdesk_user
DB_PASSWORD=

# ----------------------------------------------------------------------------
# Google OAuth — la única credencial externa (ver .env.example de la raíz)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# JWT — para el cliente móvil, que no tiene cookie de sesión
# ----------------------------------------------------------------------------
# Genera uno con: openssl rand -base64 32
JWT_SECRET=CAMBIAME_secreto_aleatorio_min_32_chars
JWT_EXPIRATION=3600

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PATH=/var/www/html/storage/logs

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_PATH=/var/www/html/storage/ratelimit
