{
  "name": "tcgdesk/backend",
  "description": "Backend PHP de TCGDesk — gestor de colecciones de TCG",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "firebase/php-jwt": "^7.0",
    "monolog/monolog": "^3.0",
    "php-di/php-di": "^7.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:coverage": "phpunit --coverage-html coverage/"
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "process-timeout": 600,
    "preferred-install": "dist"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  }
}
