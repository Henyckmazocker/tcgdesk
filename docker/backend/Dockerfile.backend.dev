# Dockerfile for PHP backend development
FROM php:8.2-apache

# Set working directory for Apache web root
WORKDIR /var/www/html

# Install system dependencies required for pdo_mysql, xdebug, and other common extensions
#
# gd entra SOLO como DECODIFICADOR de JPEG/PNG para el índice visual del catálogo
# (`Domain/Vision/PerceptualHash`): `imagecreatefromstring()` y nada más. NINGUNA
# función de GD toca el tamaño de una imagen — la reducción a 9x8 es aritmética a
# mano en PHP y en JS, y tiene que dar el mismo entero en los dos. Medido el
# 2026-09-15: cambiar solo el algoritmo de reescalado mueve el hash de la MISMA
# imagen 7 bits (BILINEAR) y 31 (NEAREST) contra un umbral de decisión de 4. Un
# `imagescale()` colado aquí rompe el índice entero en silencio.
RUN apt-get update && apt-get install -y \
    libzip-dev \
    libjpeg-dev \
    libpng-dev \
    zip \
    nano \
    git \
    curl \
    unzip \
    && docker-php-ext-configure gd --with-jpeg \
    && docker-php-ext-install pdo pdo_mysql zip gd \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug

# Install Composer
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

# Enable Apache mod_rewrite for pretty URLs (necesario para las rutas GET /api/catalog/*)
RUN a2enmod rewrite headers

# Configure Apache to serve from /var/www/html/public
RUN sed -i 's|/var/www/html|/var/www/html/public|g' /etc/apache2/sites-available/000-default.conf
RUN sed -i 's|/var/www/html|/var/www/html/public|g' /etc/apache2/apache2.conf

# Create backend storage subdirectories, permisos laxos de desarrollo
RUN mkdir -p /var/www/html/storage/cache \
    && mkdir -p /var/www/html/storage/logs \
    && mkdir -p /var/www/html/storage/sessions \
    && mkdir -p /var/www/html/storage/uploads \
    && chown -R www-data:www-data /var/www/html

# Expose port 80 for Apache
EXPOSE 80

# Set recommended PHP development settings
ENV PHP_DISPLAY_ERRORS=On
ENV PHP_ERROR_REPORTING=E_ALL
ENV PHP_MEMORY_LIMIT=512M

# Start Apache in the foreground
CMD ["apache2-foreground"]
